   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@types/express": "^5.0.6",
      "@types/http-errors": "^2.0.5",
      "@types/jest": "^30.0.0",
      "@types/node": "^26.6.1",
      "@types/supertest": "^7.2.1",
      "@types/winston": "^2.4.4",
      "cross-env": "^10.1.0",
      "eslint": "^10.8.0",
      "husky": "^9.1.7",
      "jest": "^30.4.2",
      "lint-staged": "^17.2.0",
      "nodemon": "^3.1.14",
      "prettier": "3.9.6",
      "supertest": "^7.2.2",
      "ts-jest": "^29.4.12",
      "ts-node": "^10.9.2",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.65.0"
